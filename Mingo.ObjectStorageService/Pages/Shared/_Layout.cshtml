@inject IWebHostEnvironment env

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MingoOSS</title>
    @* <script type="importmap"></script> *@
    @* <link rel="stylesheet" href="~/Mingo.ObjectStorageService.styles.css" asp-append-version="true" /> *@
    <link rel="stylesheet" vite-href="~/dist/tailwind.config.css" />
</head>

<body>
    <header>
        <div class="oss-navbar bg-base-100 shadow-sm">
            <div class="flex-1">
                <a class="oss-btn oss-btn-ghost text-xl" asp-page="/">MingoOSS</a>
            </div>
            <div class="flex-none">
                <ul class="oss-menu oss-menu-horizontal px-1">
                    <li>
                        @if (env.IsDevelopment())
                        {
                            <a href="/swagger" class="oss-btn oss-btn-secondary" target="_blank">Swagger</a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div>
            &copy; 2025 - MingoOSS - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script type="module" vite-src="~/dist/Assets/app.ts"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>