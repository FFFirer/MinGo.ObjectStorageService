@page "/"
@using Mingo.ObjectStorageService.Core
@model IndexModel
@{
    ViewData["Title"] = "Index";
}

@if (Model.Buckets is null)
{
    <p>Loading...</p>
}
else
{
    <table class="oss-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Created Time</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Buckets.IsNullOrEmpty())
            {
                <tr>
                    <td colspan="2">
                        No Data</td>
                </tr>
            }
            else
            {
                foreach (var b in Model.Buckets)
                {
                    <tr>
                        <td>
                            <a asp-page="/BucketDetails" asp-route-bucket="@(b.Id)">
                                @b.Id</a>
                        </td>
                        <td>
                            @b.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div>
        <div class="oss-join">
            <a disabled=@(!Model.Buckets.HasPreviousPage) asp-route-page="@(Model.Buckets.PageIndex - 1)"
                class="oss-join-item oss-btn @Model.Buckets.HasPreviousPage ? @("") : @("disabled")"> @("上一页") </a>

            <a class="oss-join-item oss-btn">@Model.Buckets.PageIndex</a>

            <a disabled=@(!Model.Buckets.HasNextPage) asp-route-currentPage=@(Model.Buckets.PageIndex + 1)
                class=" oss-join-item oss-btn @Model.Buckets.HasNextPage ? @("") : @("disabled") "> @("下一页")
            </a>
        </div>
    </div>
}